action "deploy_game_program" "svm::deploy_program" {
    description = "Deploy game program"
    program = svm::get_program_from_anchor_project(
        "anchor_program",
        "/artifacts/deploy/anchor_program-keypair.json",
        "/artifacts/idl/anchor_program.json",
        "/artifacts/deploy/anchor_program.so"
    )
    authority = signer.authority
    payer = signer.payer
    instant_surfnet_deployment = true
}
