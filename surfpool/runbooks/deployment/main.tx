addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

signer "payer" "svm::secret_key" {
    keypair_json = input.payer_keypair_json
}

signer "authority" "svm::secret_key" {
    keypair_json = input.authority_keypair_json
}

action "fund_admin" "svm::setup_surfnet" {
    description = "Fund account with SOL during Surfnet setup"
    set_account {
        public_key = "AdmiapAjgTDNTKHUAs7FWztVWSGPNU5zHv2YKSN5GiMg"
        lamports = svm::sol_to_lamports(10)
    }
}

action "fund_validator" "svm::setup_surfnet" {
    description = "Fund account with SOL during Surfnet setup"
    set_account {
        public_key = "mAGicPQYBMvcYveUZA5F5UNNwyHvfYh5xkLS2Fr1mev"
        lamports = svm::sol_to_lamports(10)
    }
}

# Not needed once surfpool forks devnet: the real validator fees vault (EpJnX…, owner
# DELeGG, 8 bytes) is cloned from devnet automatically. Kept commented as a fallback in
